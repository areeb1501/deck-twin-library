{
  "name": "deck-twin",
  "version": "0.2.2",
  "description": "Standards-based three.js components for oil & gas digital twins. Copy, paste, assemble.",
  "license": "MIT",
  "homepage": "https://deck-twin-library.demoareeb.workers.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/areeb1501/deck-twin-library.git"
  },
  "bugs": {
    "url": "https://github.com/areeb1501/deck-twin-library/issues"
  },
  "type": "module",
  "bin": {
    "deck-twin": "cli/deck-twin.mjs"
  },
  "files": [
    "cli"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "registry": "tsx scripts/build-registry.ts",
    "build": "npm run registry && tsc -b && vite build",
    "typecheck": "tsc -b",
    "shoot": "node scripts/shoot.mjs",
    "thumbs": "node scripts/thumbs.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && npx wrangler deploy"
  },
