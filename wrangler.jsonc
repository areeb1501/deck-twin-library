{
  "name": "deck-twin-demo",
  "compatibility_date": "2026-10-29",
  "main": "alpha/worker.js",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/alpha/media/*", "/alpha/api/*"]
  },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "deck-twin-alpha-media" }],
  // per visitor: the camera page sends about two frames a second
  "ratelimits": [{ "name": "SAM_LIMIT", "namespace_id": "7317", "simple": { "limit": 150, "period": 60 } }],
  "previews": {
    "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "deck-twin-alpha-media" }],
    "ratelimits": [{ "name": "SAM_LIMIT", "namespace_id": "7318", "simple": { "limit": 150, "period": 60 } }]
  },
  "observability": { "logs": { "enabled": false, "invocation_logs": true } }
}
