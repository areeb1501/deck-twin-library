{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deck-twin-library",
  "compatibility_date": "2026-10-29",
  "main": "alpha/worker.js",
  "workers_dev": true,
  "routes": [
    { "pattern": "decktwin.com", "custom_domain": true },
    { "pattern": "www.decktwin.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/alpha/media/*", "/alpha/api/*"]
  },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "deck-twin-alpha-media" }],
  // per visitor: the camera page sends about two frames a second
  "ratelimits": [{ "name": "SAM_LIMIT", "namespace_id": "7315", "simple": { "limit": 150, "period": 60 } }],
  "observability": {
    "logs": {
      "enabled": false,
      "invocation_logs": true
    }
  }
}
